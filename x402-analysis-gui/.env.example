# Copy this file to .env and fill in the values below for local development.
# On Vercel, set these as Project -> Settings -> Environment Variables instead.

# --- OAuth login (Auth0) -----------------------------------------------------
# Required to gate /dashboard behind Auth0 sign-in ("/" itself is a public
# landing page needing no login). Create a "Regular Web Application" at
# https://manage.auth0.com/ (Applications -> Create Application), then in its
# Settings tab add "<PUBLIC_BASE_URL>/auth/callback" to Allowed Callback URLs
# and "<PUBLIC_BASE_URL>" (no path) to Allowed Logout URLs -- both must match
# PUBLIC_BASE_URL below exactly.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Your deployed site's base URL, no trailing slash, e.g.
# https://x402-analysis-gui.vercel.app -- used to build the exact
# redirect_uri/returnTo URLs Auth0 checks against the Allowed Callback/Logout
# URLs above. For local dev this is http://localhost:8000.
PUBLIC_BASE_URL=http://localhost:8000

# Random secret used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# --- Neon Postgres (authorised users + settings) -----------------------------
# Who's allowed to log in (and each one's role/theme preference) lives in the
# user_settings table in Neon, not an env var -- see db/schema.sql and
# scripts/add_user.py. Create a project at https://console.neon.tech/, then
# copy its connection string from Connection Details. Prefer the *pooled*
# connection string (hostname contains "-pooler") since this app opens a
# fresh connection per request, appropriate for Vercel's serverless
# functions, and Neon's pooler absorbs that connect/disconnect churn better
# than a direct connection would. Must include sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# AES-256-GCM key used to encrypt the `email` column in user_settings before
# it's stored (see gui/crypto.py) -- base64-encoded 32 random bytes. Generate
# one with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
# On Vercel, set this as a Project -> Settings -> Environment Variable, not
# in this file. Losing this key makes every stored email unrecoverable;
# rotating it requires re-encrypting the whole table (decrypt with the old
# key, re-encrypt with the new one).
DB_ENCRYPTION_KEY=
