# Copy this file to .env and fill in the values below for local development.
# On Vercel, set these as Project -> Settings -> Environment Variables instead.

# --- OAuth login (Auth0) -----------------------------------------------------
# Required to gate /dashboard behind Auth0 sign-in ("/" itself is a public
# landing page needing no login). Create a "Regular Web Application" at
# https://manage.auth0.com/ (Applications -> Create Application), then in its
# Settings tab add "<PUBLIC_BASE_URL>/auth/callback" to Allowed Callback URLs
# and "<PUBLIC_BASE_URL>" (no path) to Allowed Logout URLs -- both must match
# PUBLIC_BASE_URL below exactly.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Your deployed site's base URL, no trailing slash, e.g.
# https://x402-analysis-gui.vercel.app -- used to build the exact
# redirect_uri/returnTo URLs Auth0 checks against the Allowed Callback/Logout
# URLs above. For local dev this is http://localhost:8000.
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated list of email addresses allowed to log in. Anyone else who
# successfully authenticates via Auth0 is still denied access.
ALLOWED_EMAILS=

# Random secret used to sign the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=
