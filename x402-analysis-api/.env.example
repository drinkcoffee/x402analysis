# Copy this file to .env and fill in the values below for local development.
# On Vercel, set these as Project -> Settings -> Environment Variables instead.

# --- Neon Postgres (API keys) -------------------------------------------------
# The API keys that may call this server's protected endpoints live in the
# api_keys table in Neon, not an env var -- see db/schema.sql and
# scripts/create_api_key.py. Create a project at https://console.neon.tech/,
# then copy its connection string from Connection Details. Prefer the
# *pooled* connection string (hostname contains "-pooler") since this app
# opens a fresh connection per request, appropriate for Vercel's serverless
# functions, and Neon's pooler absorbs that connect/disconnect churn better
# than a direct connection would. Must include sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxxxxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

X402_PRIVATE_KEY=