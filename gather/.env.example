# Copy to gather/.env and fill in.

# Port for gather's own Postgres server (default 5434).
# GATHER_DB_PORT=5434

# Coinbase CDP API key pair -- only needed by 03_facilitator_liveness_check.py,
# to check Coinbase's facilitator. Free from https://portal.cdp.coinbase.com/
# (Settings, API Keys, Secret API keys).
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Helius API key -- only needed by 06_find_clients_solana.py and
# 08_find_funders_solana.py (unless run with --rpc-url or --public-rpc), for Solana's
# RPC API. Free from https://www.helius.dev/ (the free plan is enough, but
# a busy server address can use a lot of its monthly credits).
HELIUS_API_KEY=
# Requests a second to send Helius (default 10, the free plan's limit).
# HELIUS_RPS=10

# Another provider's Solana mainnet RPC URL, key included (e.g. Alchemy's
# https://solana-mainnet.g.alchemy.com/v2/<key>, or a QuickNode endpoint) --
# used by 06 and 08 instead of Helius when run with --rpc-url.
# SOLANA_RPC_URL=
# Requests a second to send it (default 10; check your plan's limit).
# SOLANA_RPC_RPS=10

# A Base mainnet RPC URL, key included, for 11 to read the ERC-8004
# registry through (default: Base's free public endpoint,
# https://mainnet.base.org).
# BASE_RPC_URL=
# Calls a second to send it (default 18; the public endpoint allows 25).
# BASE_RPC_RPS=18
