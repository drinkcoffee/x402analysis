# Copy this file to .env and fill in the keys you need. x402tool loads .env
# automatically (from the current directory, or a parent of it) - nothing
# else to configure. Never commit your real .env file (it's already
# gitignored).

# Coinbase CDP API key pair, for `supported`/`verify`/`settle` against the
# `coinbase-cdp` facilitator. Get one from https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Etherscan API key (Standard plan or above), for `funded-by-etherscan`.
# Get one from https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Blockscout Pro API key, for `assoc-txs-blockscout`.
# Get one from https://dev.blockscout.com/ (free tier, no card required)
BLOCKSCOUT_API_KEY=

# Generic API key/secret fallback for the `supported`/`verify`/`settle`
# commands against generic facilitators that need one but don't have a
# facilitator-specific env var (passed via --api-key otherwise). See
# `x402tool show <id>` for which facilitators need this and how it's used.
X402_API_KEY=
